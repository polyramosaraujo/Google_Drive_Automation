rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOfCell(cellId) {
      return isSignedIn() && myProfile().cellId == cellId;
    }

    // Cells only expose their name + invite code, which is needed to look up
    // a cell by invite code during sign-up (before the user has an account).
    // Only Cloud Functions / the console can create or modify cells.
    match /cells/{cellId} {
      allow read: true;
      allow write: false;

      match /prayerRequests/{requestId} {
        allow read: if isMemberOfCell(cellId);
        allow create: if isMemberOfCell(cellId)
          && request.resource.data.authorId == request.auth.uid;
        // Only prayedCount may be updated by members (via increment) once created;
        // edits/deletes of the request text are left for a future moderation feature.
        allow update: if isMemberOfCell(cellId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedCount']);
        allow delete: if false;

        match /prayedBy/{uid} {
          allow read: if isMemberOfCell(cellId);
          allow write: if isMemberOfCell(cellId) && request.auth.uid == uid;
        }
      }
    }

    // A user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
